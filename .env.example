# --- Application ---------------------------------------------------------------
APP_NAME=DiddiGo
APP_ENV=development
API_PREFIX=/v1
# Comma-separated explicit origins for deployed frontends.
# Localhost and 127.0.0.1 are accepted on any port by CORS_ORIGIN_REGEX below.
CORS_ORIGINS=https://go-staging.diddifree.com,https://go.diddifree.com
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Database ------------------------------------------------------------------
# Local dev (host machine): use +asyncpg driver for the runtime SQLAlchemy engine.
# The docker-compose Postgres is exposed on port 5433 (to avoid colliding with
# any local Postgres on 5432). Inside docker-compose, use `db:5432`.
# Pydantic-settings reads `DATABASE_URL` (case-insensitive) → `settings.database_url`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/diddi_go

# --- Redis ---------------------------------------------------------------------
# Local dev (host machine). Inside docker-compose: replace localhost with `redis`.
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ----------------------------------------------------------------
# 32+ character random secret, unique per environment. NEVER use the example below in prod.
JWT_SECRET=change-me-in-prod-at-least-32-characters-long
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30

# --- OTP -----------------------------------------------------------------------
OTP_RATE_LIMIT_SECONDS=60
OTP_CODE_LIFETIME_SECONDS=300

# --- External services (DiddiMap core) ----------------------------------------
# DiddiMap/AbidjanMaps HTTP root. In dev without DiddiMap, the ride service
# falls back to a formula-based estimate (distance derived from coordinates).
DIDDIMAP_BASE_URL=http://abidjanmaps-backend-staging.diddifree.com

# --- Identity (DiddiFreeID) ----------------------------------------------------
# Staging example:
# IDENTITY_BASE_URL=https://auth-staging.diddifree.com
# Derived automatically:
# - JWKS:    https://auth-staging.diddifree.com/.well-known/jwks.json
# - Profile: https://auth-staging.diddifree.com/identity/v1/users/me
IDENTITY_BASE_URL=
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=diddifree-id
IDENTITY_PROFILE_URL=
IDENTITY_SERVICE_KEY=
