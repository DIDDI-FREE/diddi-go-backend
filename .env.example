# --- Application ---------------------------------------------------------------
APP_NAME=DiddiGo
APP_ENV=development
API_PREFIX=/v1

# Comma-separated explicit origins for deployed frontends.
# Localhost and 127.0.0.1 are accepted on any port by CORS_ORIGIN_REGEX below.
CORS_ORIGINS=https://go-staging.diddifree.com,https://go.diddifree.com
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# --- Database ------------------------------------------------------------------
# Local dev from the host machine. docker-compose exposes Postgres on 15433.
# Inside docker-compose/Portainer, use db:5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15433/diddi_go

# --- Redis ---------------------------------------------------------------------
# Local dev from the host machine. Inside docker-compose/Portainer, use redis:6379.
REDIS_URL=redis://localhost:16380/0

# --- Auth / JWT ----------------------------------------------------------------
# 32+ character random secret, unique per environment. NEVER use this in prod.
JWT_SECRET=change-me-in-prod-at-least-32-characters-long
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30

# --- OTP -----------------------------------------------------------------------
OTP_RATE_LIMIT_SECONDS=60
OTP_CODE_LIFETIME_SECONDS=300

# --- External services (DiddiMap / AbidjanMaps) --------------------------------
# DiddiMap is the only geographic provider. No silent fallback is allowed.
DIDDIMAP_BASE_URL=http://abidjanmaps-backend-staging.diddifree.com

# --- Identity (DiddiFreeID) ----------------------------------------------------
# Staging example:
# IDENTITY_BASE_URL=https://auth-staging.diddifree.com
# Production example:
# IDENTITY_BASE_URL=https://auth.diddifree.com
# Derived automatically:
# - JWKS:    <IDENTITY_BASE_URL>/.well-known/jwks.json
# - Profile: <IDENTITY_BASE_URL>/identity/v1/users/me
IDENTITY_BASE_URL=
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=diddifree-id
IDENTITY_PROFILE_URL=
IDENTITY_SERVICE_KEY=

# --- Push notifications --------------------------------------------------------
# FCM is the only push provider used by DiddiGo for Android and iOS.
# On iOS, Firebase forwards notifications to APNs internally after the iOS app
# and Firebase project are configured with Apple push credentials.
# FCM_SERVICE_ACCOUNT_JSON can contain the full service account JSON as one line.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# --- Payments (DiddiPay) -------------------------------------------------------
# DiddiGo calls DiddiPay server-to-server for wave/diddipay PaymentIntent flows.
# DIDDIPAY_SERVICE_KEY must never be exposed to mobile/web clients.
DIDDIPAY_BASE_URL=
DIDDIPAY_CLIENT_ID=diddigo
DIDDIPAY_SERVICE_KEY=
DIDDIPAY_CALLBACK_SECRET=
DIDDIPAY_HTTP_TIMEOUT_SECONDS=15
DIDDIGO_PAYMENT_CALLBACK_URL=

# Reconciliation: DiddiGo re-reads GET /payfund/v1/payment-intents/{id} for any
# payment still waiting on a DiddiPay callback, so a lost webhook self-heals.
# Read-only on DiddiPay's side — DiddiGo only updates its own rows.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=300
PAYMENT_RECONCILIATION_BATCH_SIZE=50
# Grace period before an intent counts as late (the payer may still be paying).
PAYMENT_RECONCILIATION_MIN_AGE_SECONDS=120
# Past this age DiddiPay has expired the intent; stop chasing it.
PAYMENT_RECONCILIATION_MAX_AGE_SECONDS=259200

# --- Production / Portainer reminder ------------------------------------------
# In production, set these in Portainer Stack > Environment variables:
# APP_ENV=production
# JWT_SECRET=<random-32+-characters-secret>
# POSTGRES_PASSWORD=<strong-password>
# IDENTITY_BASE_URL=https://auth.diddifree.com
# DIDDIMAP_BASE_URL=http://abidjanmaps-backend-staging.diddifree.com
# PUSH_ENABLED=true
# FCM_PROJECT_ID=<firebase-project-id>
# FCM_SERVICE_ACCOUNT_JSON=<firebase-service-account-json>
# DIDDIPAY_BASE_URL=https://pay-api-staging.diddifree.com/payfund/v1
# DIDDIPAY_CLIENT_ID=diddigo
# DIDDIPAY_SERVICE_KEY=<diddipay-service-key-for-diddigo>
# DIDDIPAY_CALLBACK_SECRET=<diddipay-callback-hmac-secret>
# DIDDIPAY_HTTP_TIMEOUT_SECONDS=15
#
# DATABASE_URL and REDIS_URL are optional in docker-compose.portainer.yml when
# using the internal db/redis services. Override them only for external
# PostgreSQL/Redis:
# DATABASE_URL=postgresql+asyncpg://postgres:<strong-password>@db:5432/diddi_go
# REDIS_URL=redis://redis:6379/0
