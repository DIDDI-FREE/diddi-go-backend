meta {
  name: 03 Get My Driver Profile
  type: http
  seq: 3
}

get {
  url: {{base_url}}/drivers/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{driver_access_token}}
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  test("vehicle is attached", function () {
    expect(res.body.vehicle).to.not.equal(null);
  });
}
