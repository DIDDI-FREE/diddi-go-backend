meta {
  name: 03 Accept Ride (driver)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rides/{{ride_id}}/accept
  body: none
  auth: bearer
}

auth:bearer {
  token: {{driver_access_token}}
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  test("ride is now matched", function () {
    expect(res.body.status).to.equal("matched");
  });
}

docs {
  Matching V2 opens an offer wave of up to five eligible drivers. The first driver in
  the wave who accepts wins. Other drivers from the same wave get
  `409 RIDE_ALREADY_MATCHED`; a driver answering after the 15s TTL gets
  `409 OFFER_EXPIRED`.
}
