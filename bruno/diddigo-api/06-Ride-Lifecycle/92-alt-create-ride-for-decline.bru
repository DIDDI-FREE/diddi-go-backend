meta {
  name: 92 ALT Create Ride (for decline test)
  type: http
  seq: 92
}

post {
  url: {{base_url}}/rides
  body: json
  auth: bearer
}

auth:bearer {
  token: {{passenger_access_token}}
}

body:json {
  {
    "pickup": { "lat": 5.3610, "lng": -4.0090, "address": "Rue des Jardins, Plateau" },
    "dropoff": { "lat": 5.3450, "lng": -4.0210, "address": "Rue Princesse, Cocody" },
    "vehicle_category": "standard",
    "comfort_level": "standard",
    "payment_method": "cash",
    "scheduled_at": null
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("decline_test_ride_id", res.body.ride_id);
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  ALTERNATIVE BRANCH — own `decline_test_ride_id` variable, never touches `ride_id`.
}
