meta {
  name: 04 ALT Simulate DiddiPay Webhook
  type: http
  seq: 4
}

post {
  url: {{base_url}}/internal/webhooks/diddipay
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-DiddiPay-Event-ID: {{diddipay_webhook_event_id}}
  X-DiddiPay-Signature: {{diddipay_webhook_signature}}
}

script:pre-request {
  // Pure-JS SHA-256/HMAC so this works regardless of whether the Bruno sandbox
  // exposes Node's `crypto` module. Only depends on the secret + raw body.
  function sha256(ascii) {
    function rrot(x, n) { return (x >>> n) | (x << (32 - n)); }
    const h = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
    const k = [0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
    function toBytes(str) { return new TextEncoder().encode(str); }
    let bytes = Array.from(toBytes(ascii));
    const bitLen = bytes.length * 8;
    bytes.push(0x80);
    while (bytes.length % 64 !== 56) bytes.push(0);
    for (let i = 7; i >= 0; i--) bytes.push((bitLen / Math.pow(2, i * 8)) & 0xff);
    let hh = h.slice();
    for (let chunk = 0; chunk < bytes.length; chunk += 64) {
      const w = new Array(64).fill(0);
      for (let i = 0; i < 16; i++) {
        w[i] = (bytes[chunk + i*4] << 24) | (bytes[chunk + i*4+1] << 16) | (bytes[chunk + i*4+2] << 8) | (bytes[chunk + i*4+3]);
      }
      for (let i = 16; i < 64; i++) {
        const s0 = rrot(w[i-15],7) ^ rrot(w[i-15],18) ^ (w[i-15] >>> 3);
        const s1 = rrot(w[i-2],17) ^ rrot(w[i-2],19) ^ (w[i-2] >>> 10);
        w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;
      }
      let [a,b,c,d,e,f,g,hval] = hh;
      for (let i = 0; i < 64; i++) {
        const S1 = rrot(e,6) ^ rrot(e,11) ^ rrot(e,25);
        const ch = (e & f) ^ (~e & g);
        const t1 = (hval + S1 + ch + k[i] + w[i]) | 0;
        const S0 = rrot(a,2) ^ rrot(a,13) ^ rrot(a,22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const t2 = (S0 + maj) | 0;
        hval = g; g = f; f = e; e = (d + t1) | 0;
        d = c; c = b; b = a; a = (t1 + t2) | 0;
      }
      hh = [hh[0]+a|0, hh[1]+b|0, hh[2]+c|0, hh[3]+d|0, hh[4]+e|0, hh[5]+f|0, hh[6]+g|0, hh[7]+hval|0];
    }
    return hh.map((x) => (x >>> 0).toString(16).padStart(8, "0")).join("");
  }

  function hmacSha256Hex(key, message) {
    const blockSize = 64;
    let keyBytes = Array.from(new TextEncoder().encode(key));
    if (keyBytes.length > blockSize) {
      keyBytes = hexToBytes(sha256(bytesToBinaryString(keyBytes)));
    }
    while (keyBytes.length < blockSize) keyBytes.push(0);
    const oKeyPad = keyBytes.map((b) => b ^ 0x5c);
    const iKeyPad = keyBytes.map((b) => b ^ 0x36);
    const inner = sha256(bytesToBinaryString(iKeyPad) + message);
    const outer = sha256(bytesToBinaryString(oKeyPad) + hexToBinaryString(inner));
    return outer;
  }
  function bytesToBinaryString(bytes) { return bytes.map((b) => String.fromCharCode(b)).join(""); }
  function hexToBytes(hex) { const out = []; for (let i = 0; i < hex.length; i += 2) out.push(parseInt(hex.substr(i, 2), 16)); return out; }
  function hexToBinaryString(hex) { return bytesToBinaryString(hexToBytes(hex)); }

  const eventId = "bruno-" + Date.now();
  const bodyObj = {
    id: eventId,
    type: "payment_intent.succeeded",
    data: {
      payment_intent_id: bru.getVar("diddipay_payment_intent_id") || "00000000-0000-0000-0000-000000000000",
      amount: 1500,
      currency: "XOF",
      status: "succeeded",
      business_reference: "ride:" + bru.getVar("cancel_test_ride_id")
    }
  };
  const rawBody = JSON.stringify(bodyObj);
  const secret = bru.getVar("diddipay_callback_secret");
  bru.setVar("diddipay_webhook_event_id", eventId);
  bru.setVar("diddipay_webhook_body_raw", rawBody);
  bru.setVar("diddipay_webhook_signature", secret ? hmacSha256Hex(secret, rawBody) : "");
}

body:json {
  {{diddipay_webhook_body_raw}}
}

tests {
  test("status is 204 (processed) or 401/503 if secret/config missing", function () {
    expect([204, 401, 503]).to.include(res.status);
  });
}

docs {
  ALTERNATIVE BRANCH, simulates DiddiPay calling DiddiGo's webhook — useful because this
  is the one payment path that's genuinely testable end-to-end from Bruno alone without
  a real DiddiPay instance, since DiddiGo only needs the shared HMAC secret to accept it
  (`app_base/modules/payment/application/services.py:162-166`).

  **Requires** `diddipay_callback_secret` set in the active environment (matching the
  real `DIDDIPAY_CALLBACK_SECRET` on that backend) — leave it blank and expect
  `503 PAYMENT_CONFIGURATION_MISSING`.

  Also requires `diddipay_payment_intent_id` to already point at a real, DiddiGo-known
  PaymentIntent — i.e. "03 ALT Prepare Payment" must have actually succeeded (status
  200, not 503) first. If DiddiPay isn't configured on this environment, this request
  is not runnable end-to-end yet — that's a real gap, not a Bruno limitation.

  Uses a hand-rolled pure-JS SHA-256/HMAC (no dependency on Node's `crypto` module) so
  it works regardless of Bruno's script-sandbox restrictions.
}
