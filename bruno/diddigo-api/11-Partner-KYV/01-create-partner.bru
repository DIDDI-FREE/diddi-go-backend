meta {
  name: 01 Create Partner
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/partners
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
  {
    "name": "{{partner_name}}",
    "partner_type": "fleet_owner",
    "legal_name": "{{partner_name}} SARL",
    "contact_phone": "+2250700000000",
    "contact_email": "qa-partner@diddifree.com",
    "registration_document_file_id": "{{partner_registration_file_id}}",
    "tax_document_file_id": "{{partner_tax_file_id}}",
    "representative_id_document_file_id": "{{partner_representative_file_id}}"
  }
}

script:pre-request {
  const suffix = Date.now().toString().slice(-8);
  bru.setVar("partner_name", "QA Fleet " + suffix);
  bru.setVar("partner_registration_file_id", "11111111-1111-4111-8111-111111111111");
  bru.setVar("partner_tax_file_id", "22222222-2222-4222-8222-222222222222");
  bru.setVar("partner_representative_file_id", "33333333-3333-4333-8333-333333333333");
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("partner_id", res.body.id);
  }
}

tests {
  test("partner is created", function () {
    expect(res.status).to.equal(201);
  });
  test("partner starts pending verification", function () {
    expect(res.body.status).to.equal("pending_verification");
  });
}

docs {
  Requires `admin_access_token` in the selected Bruno environment.
}
